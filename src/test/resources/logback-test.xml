<!-- Replaces logback.xml in tests: the PowSyBl libraries (Open Load Flow logging its parameters table on every run...)
     would make tens of megabytes of test output. The application's own logs stay, LogsViewControllerTest relies on them. -->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%-5p %d{HH:mm:ss.SSS} %-20C{1} | %m%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
    <logger name="com.powsybl" level="OFF" />
    <logger name="com.powsybl.powsybldesktop" level="INFO" />
</configuration>
