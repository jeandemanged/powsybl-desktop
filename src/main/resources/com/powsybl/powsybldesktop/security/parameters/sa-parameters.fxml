<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.powsybl.powsybldesktop.security.parameters.SecurityAnalysisParametersController">
    <children>
        <HBox spacing="5.0">
            <children>
                <Button mnemonicParsing="false" onAction="#onImport" text="%securityAnalysis.import">
                    <graphic>
                        <FontIcon iconLiteral="mdi2u-upload" iconSize="16"/>
                    </graphic>
                </Button>
                <Button mnemonicParsing="false" onAction="#onExport" text="%securityAnalysis.export">
                    <graphic>
                        <FontIcon iconLiteral="mdi2d-download" iconSize="16"/>
                    </graphic>
                </Button>
            </children>
            <padding>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
            </padding>
        </HBox>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
            </VBox.margin>
        </ScrollPane>
    </children>
</VBox>
