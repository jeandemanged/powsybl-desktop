<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.powsybl.powsybldesktop.report.ReportsController">
    <top>
        <ToolBar BorderPane.alignment="CENTER">
            <items>
                <Button mnemonicParsing="false" onAction="#onClearAll">
                    <graphic>
                        <FontIcon iconLiteral="mdi2t-trash-can" iconSize="16"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%desktop.common.action.clearAll"/>
                    </tooltip>
                </Button>
                <Button fx:id="exportButton" mnemonicParsing="false" onAction="#onExport">
                    <graphic>
                        <FontIcon iconLiteral="mdi2d-download" iconSize="16"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%desktop.common.action.export"/>
                    </tooltip>
                </Button>
                <Separator orientation="VERTICAL"/>
                <fx:define>
                    <ToggleGroup fx:id="severityToggleGroup"/>
                </fx:define>
                <ToggleButton mnemonicParsing="false" userData="TRACE" selected="true" toggleGroup="$severityToggleGroup">
                    <graphic>
                        <FontIcon iconLiteral="mdi2s-shoe-print" iconSize="16"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%reports.filter.trace"/>
                    </tooltip>
                </ToggleButton>
                <ToggleButton mnemonicParsing="false" userData="DEBUG" toggleGroup="$severityToggleGroup">
                    <graphic>
                        <FontIcon iconLiteral="mdi2b-bug-outline" iconSize="16"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%reports.filter.debug"/>
                    </tooltip>
                </ToggleButton>
                <ToggleButton mnemonicParsing="false" userData="INFO" toggleGroup="$severityToggleGroup">
                    <graphic>
                        <FontIcon iconLiteral="mdi2i-information-outline" iconSize="16"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%reports.filter.info"/>
                    </tooltip>
                </ToggleButton>
                <ToggleButton mnemonicParsing="false" userData="DETAIL" toggleGroup="$severityToggleGroup">
                    <graphic>
                        <FontIcon iconLiteral="mdi2t-text-box-outline" iconSize="16"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%reports.filter.detail"/>
                    </tooltip>
                </ToggleButton>
                <ToggleButton mnemonicParsing="false" userData="WARN" toggleGroup="$severityToggleGroup">
                    <graphic>
                        <FontIcon iconLiteral="mdi2a-alert-outline" iconSize="16" iconColor="darkorange"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%reports.filter.warn"/>
                    </tooltip>
                </ToggleButton>
                <ToggleButton mnemonicParsing="false" userData="ERROR" toggleGroup="$severityToggleGroup">
                    <graphic>
                        <FontIcon iconLiteral="mdi2a-alert-circle-outline" iconSize="16" iconColor="red"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%reports.filter.error"/>
                    </tooltip>
                </ToggleButton>
            </items>
        </ToolBar>
    </top>
    <center>
        <SplitPane dividerPositions="0.3" BorderPane.alignment="CENTER">
            <items>
                <AnchorPane minHeight="0.0" minWidth="0.0">
                    <children>
                        <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                                   AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <children>
                                <ListView fx:id="reportsListView"/>
                                <Label fx:id="noReportsLabel" mouseTransparent="true" text="%reports.noReportsYet"/>
                            </children>
                        </StackPane>
                    </children>
                </AnchorPane>
                <fx:include fx:id="reportDetail" source="report-view.fxml"/>
            </items>
        </SplitPane>
    </center>
</BorderPane>
