<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.powsybl.powsybldesktop.network.tables.HvdcLinesController">
   <children>
      <fx:include fx:id="columnVisibilityToolbar" source="column-visibility-toolbar.fxml"/>
      <fx:include fx:id="searchBox" source="../search/search-box.fxml"/>
      <TableView fx:id="hvdcLinesTableView" editable="true" tableMenuButtonVisible="true" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="substationColumn" text="%desktop.common.equipment.substation" editable="false" sortable="false"/>
            <TableColumn fx:id="voltageLevelColumn" text="%desktop.common.equipment.voltageLevel" editable="false" sortable="false"/>
            <TableColumn fx:id="nameColumn" text="%desktop.common.column.name" editable="false"/>
            <TableColumn fx:id="converterStationColumn" text="%hvdcLines.column.converterStation" editable="false" sortable="false"/>
            <TableColumn fx:id="connectedColumn" styleClass="centered-column" text="%desktop.common.column.connected" editable="false" sortable="false"/>
            <TableColumn fx:id="connectedComponentColumn" styleClass="centered-column" text="%desktop.common.column.connectedComponent" editable="false" sortable="false"/>
            <TableColumn fx:id="synchronousComponentColumn" styleClass="centered-column" text="%desktop.common.column.synchronousComponent" editable="false" sortable="false"/>
            <TableColumn fx:id="convertersModeColumn" text="%hvdcLines.column.convertersMode" sortable="false"/>
            <TableColumn fx:id="activePowerSetpointColumn" styleClass="right-aligned-column" text="%hvdcLines.column.activePowerSetpoint" sortable="false"/>
            <TableColumn fx:id="maxPColumn" styleClass="right-aligned-column" text="%desktop.common.column.maxP" sortable="false"/>
            <TableColumn fx:id="rColumn" styleClass="right-aligned-column" text="%desktop.common.column.r" sortable="false"/>
            <TableColumn fx:id="nominalVColumn" styleClass="right-aligned-column" text="%desktop.common.column.nominalVoltage" sortable="false"/>
            <TableColumn fx:id="pColumn" styleClass="right-aligned-column" text="%desktop.common.column.p" editable="false" sortable="false"/>
            <TableColumn fx:id="qColumn" styleClass="right-aligned-column" text="%desktop.common.column.q" editable="false" sortable="false"/>
            <TableColumn fx:id="iColumn" styleClass="right-aligned-column" text="%desktop.common.column.i" editable="false" sortable="false"/>
         </columns>
      </TableView>
   </children>
</VBox>
