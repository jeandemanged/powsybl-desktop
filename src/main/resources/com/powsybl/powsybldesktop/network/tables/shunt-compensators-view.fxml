<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.powsybl.powsybldesktop.network.tables.ShuntCompensatorsController">
   <children>
      <fx:include fx:id="columnVisibilityToolbar" source="column-visibility-toolbar.fxml"/>
      <fx:include fx:id="searchBox" source="../search/search-box.fxml"/>
      <TableView fx:id="shuntCompensatorsTableView" editable="true" tableMenuButtonVisible="true" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="substationColumn" text="%desktop.common.equipment.substation" editable="false"/>
            <TableColumn fx:id="voltageLevelColumn" text="%desktop.common.equipment.voltageLevel" editable="false"/>
            <TableColumn fx:id="nameColumn" text="%desktop.common.column.name" editable="false"/>
            <TableColumn fx:id="connectedColumn" styleClass="centered-column" text="%desktop.common.column.connected" editable="false"/>
            <TableColumn fx:id="connectedComponentColumn" styleClass="centered-column" text="%desktop.common.column.connectedComponent" editable="false"/>
            <TableColumn fx:id="synchronousComponentColumn" styleClass="centered-column" text="%desktop.common.column.synchronousComponent" editable="false"/>
            <TableColumn fx:id="typeColumn" text="%desktop.common.column.type" editable="false"/>
            <TableColumn fx:id="modelTypeColumn" text="%shuntCompensators.column.modelType" editable="false"/>
            <TableColumn fx:id="sectionColumn" styleClass="centered-column" text="%shuntCompensators.column.section"/>
            <TableColumn fx:id="maximumSectionColumn" styleClass="centered-column" text="%shuntCompensators.column.maximumSection" editable="false"/>
            <TableColumn fx:id="voltageRegulatorOnColumn" styleClass="centered-column" text="%desktop.common.column.voltageRegulation"/>
            <TableColumn fx:id="targetVColumn" styleClass="right-aligned-column" text="%desktop.common.column.targetV"/>
            <TableColumn fx:id="targetDeadbandColumn" styleClass="right-aligned-column" text="%desktop.common.column.targetDeadband"/>
            <TableColumn fx:id="regulatedBusVoltageColumn" styleClass="right-aligned-column" text="%generators.column.regulatedBusVoltage" editable="false"/>
            <TableColumn fx:id="solvedSectionColumn" styleClass="centered-column" text="%shuntCompensators.column.solvedSection" editable="false"/>
            <TableColumn fx:id="pColumn" styleClass="right-aligned-column" text="%desktop.common.column.p" editable="false"/>
            <TableColumn fx:id="qColumn" styleClass="right-aligned-column" text="%desktop.common.column.q" editable="false"/>
            <TableColumn fx:id="iColumn" styleClass="right-aligned-column" text="%desktop.common.column.i" editable="false"/>
         </columns>
      </TableView>
   </children>
</VBox>
