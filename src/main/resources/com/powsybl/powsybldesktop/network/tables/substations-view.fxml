<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.powsybl.powsybldesktop.network.tables.SubstationsTableController">
   <children>
      <fx:include fx:id="searchBox" source="../search/search-box.fxml"/>
      <TableView fx:id="substationsTableView" editable="true" tableMenuButtonVisible="true" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="nameColumn" text="%common.column.name" editable="false"/>
            <TableColumn fx:id="countryColumn" text="%substations.column.country"/>
            <TableColumn fx:id="tsoColumn" text="%substations.column.tso"/>
            <TableColumn fx:id="geographicalTagsColumn" text="%substations.column.geographicalTags" editable="false"/>
         </columns>
      </TableView>
   </children>
</VBox>
