<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="4" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.powsybl.powsybldesktop.contingency.DefaultContingencyListFormController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <children>
                <Label text="%contingencies.name"/>
                <TextField fx:id="nameField" HBox.hgrow="ALWAYS"/>
            </children>
        </HBox>
        <SplitPane dividerPositions="0.6" orientation="VERTICAL" VBox.vgrow="ALWAYS">
            <items>
                <VBox spacing="4">
                    <children>
                        <HBox spacing="4">
                            <children>
                                <Button mnemonicParsing="false" onAction="#onAddContingency">
                                    <graphic>
                                        <FontIcon iconLiteral="mdi2p-plus" iconSize="14"/>
                                    </graphic>
                                </Button>
                                <Button fx:id="removeContingencyButton" mnemonicParsing="false" onAction="#onRemoveContingency">
                                    <graphic>
                                        <FontIcon iconLiteral="mdi2m-minus" iconSize="14"/>
                                    </graphic>
                                </Button>
                            </children>
                        </HBox>
                        <TableView fx:id="contingenciesTableView" editable="true" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="idColumn" editable="true" text="%contingencies.column.id"/>
                                <TableColumn fx:id="elementsColumn" editable="false" text="%contingencies.defaultList.elements"/>
                            </columns>
                        </TableView>
                    </children>
                </VBox>
                <VBox spacing="4">
                    <children>
                        <HBox spacing="4">
                            <children>
                                <Button mnemonicParsing="false" onAction="#onAddElement" text="%contingencies.defaultList.addElement">
                                    <graphic>
                                        <FontIcon iconLiteral="mdi2p-plus" iconSize="14"/>
                                    </graphic>
                                </Button>
                                <Button fx:id="removeElementButton" mnemonicParsing="false" onAction="#onRemoveElement">
                                    <graphic>
                                        <FontIcon iconLiteral="mdi2m-minus" iconSize="14"/>
                                    </graphic>
                                </Button>
                            </children>
                        </HBox>
                        <TableView fx:id="elementsTableView" editable="true" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="elementTypeColumn" editable="true" text="%contingencies.defaultList.column.elementType"/>
                                <TableColumn fx:id="elementIdColumn" editable="true" text="%contingencies.defaultList.column.elementId"/>
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </items>
        </SplitPane>
    </children>
</VBox>
