{
  "name": "PowSyBl Desktop (Claude Code sandbox)",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:Europe/Paris}"
    }
  },
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "vscjava.vscode-java-pack"
      ]
    }
  },
  "remoteUser": "ubuntu",
  "mounts": [
    "source=powsybl-desktop-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=powsybl-desktop-claude-config-${devcontainerId},target=/home/ubuntu/.claude,type=volume",
    "source=powsybl-desktop-m2,target=/home/ubuntu/.m2,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/ubuntu/.claude"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand"
}
